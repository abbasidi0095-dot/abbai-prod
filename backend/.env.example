# Copy this file to .env and fill in your credentials.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# SQLite for local development
DATABASE_URL=file:./data/dev.db

# Redis (optional for local dev; falls back to memory)
REDIS_URL=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Storage bucket for attachments
SUPABASE_STORAGE_BUCKET=attachments

# AI provider API keys
GOOGLE_AI_API_KEY=your-google-ai-studio-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Security
SESSION_SECRET=change-this-to-a-random-string-min-32-chars
ENCRYPTION_KEY=change-this-to-a-random-32-byte-key
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
